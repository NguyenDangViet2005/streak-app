{
  "name": "streak-garden",
  "version": "1.0.0",
  "private": true,
  "description": "Personal streak tracker — Express MVC, EJS, MongoDB and home screen widgets",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
